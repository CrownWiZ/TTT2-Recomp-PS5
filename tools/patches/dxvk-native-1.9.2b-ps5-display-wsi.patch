diff --git a/src/wsi/display/wsi_helpers_display.h b/src/wsi/display/wsi_helpers_display.h
new file mode 100644
index 00000000..f6c6b297
--- /dev/null
+++ b/src/wsi/display/wsi_helpers_display.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <windows.h>
+
+#include <cstdint>
+#include <cstdlib>
+
+#include "../wsi_monitor.h"
+#include "../wsi_mode.h"
+
+#include <wsi/native_display.h>
+
+namespace dxvk::wsi {
+
+  // The console has exactly one display: the TV on sceVideoOut, owned by the
+  // port's video shell. The shell publishes the active VideoOut resolution via
+  // env so DXGI's desktop coordinates match it without a Vulkan round-trip.
+  inline uint32_t displayWidth() {
+    static uint32_t w = [] {
+      const char* e = std::getenv("TTT2_VIDEO_W");
+      return e ? uint32_t(std::strtoul(e, nullptr, 0)) : 1920u;
+    }();
+    return w;
+  }
+
+  inline uint32_t displayHeight() {
+    static uint32_t h = [] {
+      const char* e = std::getenv("TTT2_VIDEO_H");
+      return e ? uint32_t(std::strtoul(e, nullptr, 0)) : 1080u;
+    }();
+    return h;
+  }
+
+}
diff --git a/src/wsi/display/wsi_mode_display.cpp b/src/wsi/display/wsi_mode_display.cpp
new file mode 100644
index 00000000..8c8c17b5
--- /dev/null
+++ b/src/wsi/display/wsi_mode_display.cpp
@@ -0,0 +1,48 @@
+#include "../wsi_mode.h"
+
+#include "wsi_helpers_display.h"
+
+namespace dxvk::wsi {
+
+  // One mode: the VideoOut resolution the shell reported. The PS5 RADV's
+  // VideoOut swapchain (wsi_common_videoout.c) paces on the display's vblank
+  // (59.94/119.88 Hz measured by the M4 spike), so the nominal 60 Hz here is
+  // only what DXGI reports to the game.
+  static bool videoOutMode(uint32_t modeNumber, WsiMode* pMode) {
+    if (modeNumber != 0)
+      return false;
+
+    pMode->width        = displayWidth();
+    pMode->height       = displayHeight();
+    pMode->refreshRate  = { 60u, 1u };
+    pMode->bitsPerPixel = 32;
+    pMode->interlaced   = false;
+    return true;
+  }
+
+  bool getDisplayMode(
+          HMONITOR         hMonitor,
+          uint32_t         ModeNumber,
+          WsiMode*         pMode) {
+    if (!isDisplayMonitor(hMonitor))
+      return false;
+    return videoOutMode(ModeNumber, pMode);
+  }
+
+  bool getCurrentDisplayMode(
+          HMONITOR         hMonitor,
+          WsiMode*         pMode) {
+    if (!isDisplayMonitor(hMonitor))
+      return false;
+    return videoOutMode(0, pMode);
+  }
+
+  bool getDesktopDisplayMode(
+          HMONITOR         hMonitor,
+          WsiMode*         pMode) {
+    if (!isDisplayMonitor(hMonitor))
+      return false;
+    return videoOutMode(0, pMode);
+  }
+
+}
diff --git a/src/wsi/display/wsi_monitor_display.cpp b/src/wsi/display/wsi_monitor_display.cpp
new file mode 100644
index 00000000..42bf707b
--- /dev/null
+++ b/src/wsi/display/wsi_monitor_display.cpp
@@ -0,0 +1,41 @@
+#include "../wsi_monitor.h"
+
+#include "wsi_helpers_display.h"
+
+namespace dxvk::wsi {
+
+  HMONITOR getDefaultMonitor() {
+    return reinterpret_cast<HMONITOR>(DisplayMonitorToken);
+  }
+
+  HMONITOR enumMonitors(uint32_t index) {
+    return index == 0 ? getDefaultMonitor() : nullptr;
+  }
+
+  bool getDisplayName(
+          HMONITOR         hMonitor,
+          WCHAR            (&Name)[32]) {
+    if (!isDisplayMonitor(hMonitor))
+      return false;
+
+    // L"PS5 VideoOut", spelled out for the WCHAR buffer contract.
+    const WCHAR name[] = { L'P', L'S', L'5', L' ', L'V', L'i', L'd', L'e', L'o', L'O', L'u', L't', L'\0' };
+    for (uint32_t i = 0; name[i] && i < 32; i++)
+      Name[i] = name[i];
+    return true;
+  }
+
+  bool getDesktopCoordinates(
+          HMONITOR         hMonitor,
+          RECT*            pRect) {
+    if (!isDisplayMonitor(hMonitor))
+      return false;
+
+    pRect->left   = 0;
+    pRect->top    = 0;
+    pRect->right  = LONG(displayWidth());
+    pRect->bottom = LONG(displayHeight());
+    return true;
+  }
+
+}
diff --git a/src/wsi/display/wsi_presenter_display.cpp b/src/wsi/display/wsi_presenter_display.cpp
new file mode 100644
index 00000000..a3448740
--- /dev/null
+++ b/src/wsi/display/wsi_presenter_display.cpp
@@ -0,0 +1,85 @@
+#include "../wsi_presenter.h"
+
+#include "wsi_helpers_display.h"
+
+#include <wsi/native_wsi.h>
+
+#include "../../util/log/log.h"
+#include "../../util/util_string.h"
+
+#include <array>
+#include <vector>
+
+namespace dxvk::wsi {
+
+  // The PS5 RADV (wsi_common_videoout.c) presents through VK_KHR_display over
+  // sceVideoOut. Resolve the display entry points per-instance instead of
+  // threading them through DXVK's loader tables: the static RADV exposes them
+  // via its ICD entry point, and DXVK's InstanceFn does not carry KHR_display.
+  VkResult createSurface(
+          HWND                hWindow,
+    const Rc<vk::InstanceFn>& vki,
+          VkSurfaceKHR*       pSurface) {
+    if (!isDisplayWindow(hWindow))
+      Logger::warn("display WSI: unexpected window token");
+
+    auto getPhysDevDisplayProps = reinterpret_cast<PFN_vkGetPhysicalDeviceDisplayPropertiesKHR>(
+      vki->sym("vkGetPhysicalDeviceDisplayPropertiesKHR"));
+    auto getDisplayModeProps = reinterpret_cast<PFN_vkGetDisplayModePropertiesKHR>(
+      vki->sym("vkGetDisplayModePropertiesKHR"));
+    auto createDisplaySurface = reinterpret_cast<PFN_vkCreateDisplayPlaneSurfaceKHR>(
+      vki->sym("vkCreateDisplayPlaneSurfaceKHR"));
+
+    if (!getPhysDevDisplayProps || !getDisplayModeProps || !createDisplaySurface)
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+
+    uint32_t devCount = 0;
+    if (vki->vkEnumeratePhysicalDevices(vki->instance(), &devCount, nullptr) != VK_SUCCESS || !devCount)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+    std::array<VkPhysicalDevice, 1> devs = { };
+    if (vki->vkEnumeratePhysicalDevices(vki->instance(), &devCount, devs.data()) != VK_SUCCESS)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+    uint32_t dispCount = 0;
+    if (getPhysDevDisplayProps(devs[0], &dispCount, nullptr) != VK_SUCCESS || !dispCount)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+    std::vector<VkDisplayPropertiesKHR> disps(dispCount);
+    if (getPhysDevDisplayProps(devs[0], &dispCount, disps.data()) != VK_SUCCESS)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+    uint32_t modeCount = 0;
+    if (getDisplayModeProps(devs[0], disps[0].display, &modeCount, nullptr) != VK_SUCCESS || !modeCount)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+    std::vector<VkDisplayModePropertiesKHR> modes(modeCount);
+    if (getDisplayModeProps(devs[0], disps[0].display, &modeCount, modes.data()) != VK_SUCCESS)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+    // Prefer the mode matching the VideoOut resolution the shell reported.
+    VkDisplayModeKHR mode = modes[0].displayMode;
+    for (const auto& m : modes) {
+      if (m.parameters.visibleRegion.width  == displayWidth()
+       && m.parameters.visibleRegion.height == displayHeight()) {
+        mode = m.displayMode;
+        break;
+      }
+    }
+
+    VkDisplaySurfaceCreateInfoKHR info = { VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR };
+    info.flags            = 0;
+    info.displayMode      = mode;
+    info.planeIndex       = 0;
+    info.planeStackIndex  = 0;
+    info.transform        = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+    info.alphaMode        = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+    info.globalAlpha      = 0.0f;
+
+    VkResult vr = createDisplaySurface(vki->instance(), &info, nullptr, pSurface);
+    if (vr != VK_SUCCESS)
+      Logger::err(str::format("display WSI: vkCreateDisplayPlaneSurfaceKHR failed: ", vr));
+    return vr;
+  }
+
+}
diff --git a/src/wsi/display/wsi_window_display.cpp b/src/wsi/display/wsi_window_display.cpp
new file mode 100644
index 00000000..270ddcf4
--- /dev/null
+++ b/src/wsi/display/wsi_window_display.cpp
@@ -0,0 +1,63 @@
+#include "../wsi_window.h"
+
+#include "wsi_helpers_display.h"
+
+namespace dxvk::wsi {
+
+  void getWindowSize(
+          HWND      hWindow,
+          uint32_t* pWidth,
+          uint32_t* pHeight) {
+    if (!isDisplayWindow(hWindow))
+      return;
+
+    if (pWidth)
+      *pWidth  = displayWidth();
+    if (pHeight)
+      *pHeight = displayHeight();
+  }
+
+  void resizeWindow(
+          HWND             hWindow,
+          DxvkWindowState* pState,
+          uint32_t         Width,
+          uint32_t         Height) {
+    // The console "window" is the TV; nothing to resize.
+  }
+
+  bool setWindowMode(
+          HMONITOR         hMonitor,
+          HWND             hWindow,
+    const WsiMode*         pMode,
+          bool             EnteringFullscreen) {
+    return true;
+  }
+
+  bool enterFullscreenMode(
+          HMONITOR         hMonitor,
+          HWND             hWindow,
+          DxvkWindowState* pState,
+          bool             ModeSwitch) {
+    // The display-plane surface is exclusive by construction.
+    return true;
+  }
+
+  bool leaveFullscreenMode(
+          HWND             hWindow,
+          DxvkWindowState* pState) {
+    return true;
+  }
+
+  bool restoreDisplayMode(HMONITOR hMonitor) {
+    return true;
+  }
+
+  HMONITOR getWindowMonitor(HWND hWindow) {
+    return getDefaultMonitor();
+  }
+
+  bool isWindow(HWND hWindow) {
+    return isDisplayWindow(hWindow);
+  }
+
+}
