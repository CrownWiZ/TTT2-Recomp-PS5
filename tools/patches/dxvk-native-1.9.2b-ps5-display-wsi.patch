diff --git a/include/native/wsi/native_display.h b/include/native/wsi/native_display.h
new file mode 100644
index 00000000..f43c950c
--- /dev/null
+++ b/include/native/wsi/native_display.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <cstdint>
+
+// PS5 console WSI: there is no window manager. The port's video shell mints
+// opaque tokens for the single sceVideoOut "window" and the TV; every WSI
+// entry point accepts only those tokens.
+namespace dxvk::wsi {
+
+  constexpr intptr_t DisplayWindowToken  = 1;
+  constexpr intptr_t DisplayMonitorToken = 1;
+
+  inline bool isDisplayWindow(HWND hWindow) {
+    return reinterpret_cast<intptr_t>(hWindow) == DisplayWindowToken;
+  }
+
+  inline bool isDisplayMonitor(HMONITOR hMonitor) {
+    return reinterpret_cast<intptr_t>(hMonitor) == DisplayMonitorToken;
+  }
+
+}
