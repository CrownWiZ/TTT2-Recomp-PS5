+  Rc<DxvkFramebuffer> DxvkContext::getFramebuffer(const DxvkRenderTargets& targets) {
+    // Image views and framebuffer dimensions are immutable. Match all views
+    // and layouts so the render-pass format and compatibility are unchanged.
+    if (m_state.om.framebuffer != nullptr && m_state.om.framebuffer->hasTargets(targets)) {
+      if (m_framebufferRetainLists) {
+        for (uint32_t i = 0; i < m_framebufferCacheUsed; ++i)
+          if (m_framebufferCache[i] == m_state.om.framebuffer)
+            m_framebufferCacheAge[i] = 0;
+      }
+      return m_state.om.framebuffer;
+    }
+
+    for (uint32_t i = 0; i < m_framebufferCacheUsed; ++i) {
+      const auto& framebuffer = m_framebufferCache[i];
+      if (framebuffer->hasTargets(targets)) {
+        m_framebufferCacheAge[i] = 0;
+        return framebuffer;
+      }
+    }
+
+    auto framebuffer = m_device->createFramebuffer(targets);
+    m_framebufferCache[m_framebufferCacheNext] = framebuffer;
+    m_framebufferCacheAge[m_framebufferCacheNext] = 0;
+    m_framebufferCacheUsed = std::min(m_framebufferCacheUsed + 1, m_framebufferCacheLimit);
+    m_framebufferCacheNext = (m_framebufferCacheNext + 1) % m_framebufferCacheLimit;
+    return framebuffer;
+  }
