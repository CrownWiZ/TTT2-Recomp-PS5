diff --git a/src/dxvk/hud/dxvk_hud_visibility.h b/src/dxvk/hud/dxvk_hud_visibility.h
new file mode 100644
--- /dev/null
+++ b/src/dxvk/hud/dxvk_hud_visibility.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <chrono>
+#include <fstream>
+#include <string>
+#include <utility>
+
+namespace dxvk::hud {
+
+  // Only the render thread accesses this state. An empty path preserves the
+  // normal DXVK HUD; opting into a settings file makes visibility default off.
+  class HudVisibilityGate {
+  public:
+    using Clock = std::chrono::steady_clock;
+
+    explicit HudVisibilityGate(std::string path)
+    : m_path(std::move(path)) { }
+
+    bool visible(Clock::time_point now = Clock::now()) {
+      if (m_path.empty())
+        return true;
+
+      if (now >= m_nextCheck) {
+        m_nextCheck = now + std::chrono::milliseconds(250);
+        std::ifstream input(m_path);
+        std::string value;
+        m_visible = input && std::getline(input, value) && value == "1";
+      }
+      return m_visible;
+    }
+
+  private:
+    std::string       m_path;
+    Clock::time_point m_nextCheck = {};
+    bool              m_visible = false;
+  };
+
+}
