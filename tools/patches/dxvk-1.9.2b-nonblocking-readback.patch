+
 constexpr static uint32_t MinFlushIntervalUs = 750;
 constexpr static uint32_t IncFlushIntervalUs = 250;
 constexpr static uint32_t MaxPendingSubmits  = 6;
 
 namespace dxvk {
+  namespace {
+    // Diagnostic override for comparing the same scene without restarting.
+    // Missing control file keeps the startup value (enabled unless set to 0).
+    bool Ttt2NonblockingReadbackEnabled() {
+      static const bool initial = env::getEnvVar("DXVK_TTT2_NONBLOCKING_READBACK") != "0";
+      static const std::string path = env::getEnvVar("DXVK_TTT2_READBACK_MODE_FILE");
+      if (path.empty()) return initial;
+      static thread_local bool enabled = initial;
+      static thread_local auto next = std::chrono::steady_clock::time_point{};
+      const auto now = std::chrono::steady_clock::now();
+      if (now >= next) {
+        next = now + std::chrono::seconds(1);
+        const bool previous = enabled;
+        enabled = initial;
+        if (FILE* file = std::fopen(path.c_str(), "r")) {
+          int value = 0;
+          if (std::fscanf(file, "%d", &value) == 1 && (value == 0 || value == 1))
+            enabled = value != 0;
+          std::fclose(file);
+        }
+        if (previous != enabled)
+          std::fprintf(stderr, "[dxvk-readback] nonblocking CS check %s\n", enabled ? "on" : "off");
+      }
+      return enabled;
+    }
+  }
   
