diff --git a/src/dxvk/dxvk_pipecache.cpp b/src/dxvk/dxvk_pipecache.cpp
index 0ea775b..cbc3510 100644
--- a/src/dxvk/dxvk_pipecache.cpp
+++ b/src/dxvk/dxvk_pipecache.cpp
@@ -1,26 +1,140 @@
 #include "dxvk_pipecache.h"
 
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
 namespace dxvk {
   
   DxvkPipelineCache::DxvkPipelineCache(
-    const Rc<vk::DeviceFn>& vkd)
-  : m_vkd(vkd) {
+    const Rc<vk::DeviceFn>& vkd,
+    const VkPhysicalDeviceProperties& properties)
+  : m_vkd(vkd), m_driverVersion(properties.driverVersion) {
+    // Opt-in path: the Android host keeps this driver-specific data in app
+    // storage. The DXVK state cache remains the portable pipeline recipe.
+    m_path = env::getEnvVar("DXVK_PIPELINE_CACHE_FILE");
+    constexpr size_t maxCacheBytes = 128u << 20;
+    std::vector<uint8_t> initial;
+    if (!m_path.empty()) {
+      std::ifstream file(m_path, std::ios::binary | std::ios::ate);
+      const auto size = file ? std::streamoff(file.tellg()) : 0;
+      if (size >= 48 && size <= std::streamoff(maxCacheBytes)) {
+        std::vector<uint8_t> bytes(static_cast<size_t>(size));
+        file.seekg(0);
+        file.read(reinterpret_cast<char*>(bytes.data()), bytes.size());
+        uint32_t header[4]{};
+        uint32_t driver = 0, version = 0;
+        std::memcpy(&driver, bytes.data() + 8, 4);
+        std::memcpy(&version, bytes.data() + 12, 4);
+        std::memcpy(header, bytes.data() + 16, sizeof(header));
+        if (file && !std::memcmp(bytes.data(), "TTT2VK01", 8)
+         && driver == m_driverVersion && version == 1
+         && header[0] == 32 && header[1] == VK_PIPELINE_CACHE_HEADER_VERSION_ONE
+         && header[2] == properties.vendorID && header[3] == properties.deviceID
+         && !std::memcmp(bytes.data() + 32, properties.pipelineCacheUUID, VK_UUID_SIZE)) {
+          initial.assign(bytes.begin() + 16, bytes.end());
+          Logger::info(str::format("DXVK: Loaded Vulkan pipeline binary cache: ", initial.size(), " bytes"));
+        } else {
+          Logger::info("DXVK: Ignoring incompatible Vulkan pipeline binary cache");
+        }
+      } else if (size) {
+        Logger::warn("DXVK: Ignoring invalid Vulkan pipeline binary cache size");
+      }
+    }
     VkPipelineCacheCreateInfo info;
     info.sType            = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
     info.pNext            = nullptr;
     info.flags            = 0;
-    info.initialDataSize  = 0;
-    info.pInitialData     = nullptr;
+    info.initialDataSize  = initial.size();
+    info.pInitialData     = initial.data();
     
     if (m_vkd->vkCreatePipelineCache(m_vkd->device(),
-        &info, nullptr, &m_handle) != VK_SUCCESS)
-      throw DxvkError("DxvkPipelineCache: Failed to create cache");
+        &info, nullptr, &m_handle) != VK_SUCCESS) {
+      info.initialDataSize = 0;
+      info.pInitialData = nullptr;
+      if (initial.empty() || m_vkd->vkCreatePipelineCache(m_vkd->device(),
+          &info, nullptr, &m_handle) != VK_SUCCESS)
+        throw DxvkError("DxvkPipelineCache: Failed to create cache");
+      Logger::warn("DXVK: Driver rejected pipeline binary cache; using an empty cache");
+      initial.clear();
+    }
+    m_savedData = std::move(initial);
+    if (!m_path.empty())
+      m_writer = dxvk::thread([this] { writerFunc(); });
   }
   
   
   DxvkPipelineCache::~DxvkPipelineCache() {
+    if (m_writer.joinable()) {
+      { std::lock_guard<std::mutex> lock(m_saveMutex);
+        m_stop = true;
+      }
+      m_saveCond.notify_one();
+      m_writer.join();
+    }
     m_vkd->vkDestroyPipelineCache(
       m_vkd->device(), m_handle, nullptr);
   }
+
+  void DxvkPipelineCache::writerFunc() {
+    env::setThreadName("dxvk-cache");
+    for (;;) {
+      std::unique_lock<std::mutex> lock(m_saveMutex);
+      m_saveCond.wait_for(lock, std::chrono::seconds(5), [this] { return m_stop; });
+      const bool stop = m_stop;
+      lock.unlock();
+      try {
+        save();
+      } catch (const std::exception& e) {
+        Logger::warn(str::format("DXVK: Could not save Vulkan pipeline binary cache: ", e.what()));
+      }
+      if (stop) return;
+    }
+  }
+
+  void DxvkPipelineCache::save() {
+    const uint64_t generation = m_generation.load(std::memory_order_relaxed);
+    if (generation == m_savedGeneration) return;
+    const auto start = dxvk::high_resolution_clock::now();
+    std::vector<uint8_t> bytes;
+    VkResult result = VK_INCOMPLETE;
+    // Pipeline creation may grow this internally synchronized Vulkan cache
+    // between the size query and read. Retry rather than save a partial blob.
+    for (int retry = 0; retry < 3 && result == VK_INCOMPLETE; ++retry) {
+      size_t size = 0;
+      if (m_vkd->vkGetPipelineCacheData(m_vkd->device(), m_handle, &size, nullptr) != VK_SUCCESS
+       || size < 32 || size > (128u << 20)) return;
+      bytes.resize(size);
+      result = m_vkd->vkGetPipelineCacheData(m_vkd->device(), m_handle, &size, bytes.data());
+      bytes.resize(size);
+    }
+    if (result != VK_SUCCESS) return;
+    if (bytes == m_savedData) {
+      m_savedGeneration = generation;
+      Logger::info(str::format("DXVK: Vulkan pipeline binary cache unchanged; created ",
+        generation, " pipelines; creation-call sum ",
+        m_creationNs.load(std::memory_order_relaxed) / 1000000, " ms"));
+      return;
+    }
+    const std::string temporary = m_path + ".tmp";
+    {
+      std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+      const uint32_t version = 1;
+      file.write("TTT2VK01", 8);
+      file.write(reinterpret_cast<const char*>(&m_driverVersion), 4);
+      file.write(reinterpret_cast<const char*>(&version), 4);
+      file.write(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+      file.flush();
+      if (!file) return;
+    }
+    if (std::rename(temporary.c_str(), m_path.c_str())) return;
+    m_savedGeneration = generation;
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+      dxvk::high_resolution_clock::now() - start).count();
+    Logger::info(str::format("DXVK: Saved Vulkan pipeline binary cache: ", bytes.size(),
+      " bytes in ", ms, " ms; created ", generation, " pipelines; creation-call sum ",
+      m_creationNs.load(std::memory_order_relaxed) / 1000000, " ms"));
+    m_savedData = std::move(bytes);
+  }
   
 }
