+    uint64_t                m_savedGeneration = 0;
+    std::vector<uint8_t>     m_savedData;
+    std::mutex              m_saveMutex;
+    std::condition_variable m_saveCond;
+    bool                    m_stop = false;
+    dxvk::thread            m_writer;
+
+    void writerFunc();
+    void save();
     
   };
   
