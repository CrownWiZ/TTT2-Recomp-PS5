new file mode 100644
index 0000000..b682de5
--- /dev/null
+++ b/include/native/wsi/native_sdl3.h
@@ -0,0 +1,24 @@
+#include <cstdint>
+#include <windows.h>
+
+#include <SDL3/SDL.h>
+
+namespace dxvk::wsi {
+
+  inline SDL_Window* fromHwnd(HWND hWindow) {
+    return reinterpret_cast<SDL_Window*>(hWindow);
+  }
+
+  inline HWND toHwnd(SDL_Window* pWindow) {
+    return reinterpret_cast<HWND>(pWindow);
+  }
+
+  inline SDL_DisplayID fromHmonitor(HMONITOR hMonitor) {
+    return static_cast<SDL_DisplayID>(reinterpret_cast<intptr_t>(hMonitor));
+  }
+
+  inline HMONITOR toHmonitor(SDL_DisplayID displayId) {
+    return reinterpret_cast<HMONITOR>(static_cast<intptr_t>(displayId));
+  }
+
+}
