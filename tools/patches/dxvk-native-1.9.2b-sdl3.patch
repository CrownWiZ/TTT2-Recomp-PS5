diff --git a/src/wsi/sdl3/wsi_helpers_sdl2.h b/src/wsi/sdl3/wsi_helpers_sdl2.h
new file mode 100644
index 0000000..366f9f4
--- /dev/null
+++ b/src/wsi/sdl3/wsi_helpers_sdl2.h
@@ -0,0 +1,15 @@
+#pragma once
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_vulkan.h>
+
+#include "../wsi_monitor.h"
+
+namespace dxvk {
+
+  inline bool isDisplayValid(SDL_DisplayID displayId) {
+    SDL_Rect bounds = { };
+    return displayId != 0 && SDL_GetDisplayBounds(displayId, &bounds);
+  }
